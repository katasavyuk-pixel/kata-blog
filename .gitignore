# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# content layer (Velite, Fase 1)
/.velite

# radar collector output (regenerated on every run, consumed by CI)
/scratch

# supabase local
/supabase/.temp
/supabase/.branches

# local verification artifacts
/.playwright-mcp
/.playwright-cli
/*.png
/scrollcraft/builds/*/lab/

# typescript
*.tsbuildinfo
next-env.d.ts

# Salida de Graphify: 2 MB de grafo regenerable, y `vercel deploy --prod`
# sube lo que no esté ignorado.
/graphify-out

# Artefacto derivado: la fuente está en lead-magnets/*/zip/
lead-magnets/**/*.zip
